# ============================================================
# Plantilla de variables de entorno - Junta Zaror
# 1) Copia este archivo como .env (el .env NO se sube a git)
# 2) Reemplaza los valores "cambia-..." por valores propios
#    (para generar uno aleatorio:  openssl rand -hex 32)
# Lo usan: docker compose (automático) y VS Code (.vscode/launch.json -> envFile)
# ============================================================

# Secreto JWT compartido por ms-auth, ms-gateway y los ms de negocio (mínimo 32 caracteres)
JWT_SECRET=cambia-este-secreto-jwt-por-uno-aleatorio-de-64-caracteres

# Clave para llamadas internas entre microservicios (header X-Internal-Key)
INTERNAL_KEY=cambia-esta-clave-interna

# MySQL: usuario de la app y contraseñas
DB_USER=zaror
DB_PASSWORD=cambia-esta-contrasena
DB_ROOT_PASSWORD=cambia-esta-contrasena-root

# Webpay Plus - AMBIENTE DE INTEGRACIÓN (sin dinero real).
# Estas son las credenciales PÚBLICAS de prueba que publica Transbank para integración.
WEBPAY_COMMERCE_CODE=597055555532
WEBPAY_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C

# URL a la que Webpay devuelve al vecino.
# 10.0.2.2 = localhost del PC visto desde el emulador Android.
# Para probar desde el navegador del PC usa: http://localhost:8080/api/pagos/webpay/retorno
WEBPAY_RETURN_URL=http://10.0.2.2:8080/api/pagos/webpay/retorno
