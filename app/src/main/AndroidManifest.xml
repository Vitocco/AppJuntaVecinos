<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Para conectarse al backend y descargar las fotos de las sedes -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 17 (API 37): para conectarse a una IP de la red local / privada
         (10.0.2.2 = el PC visto desde el emulador) la app debe tener este permiso.
         Es "peligroso": además de declararlo se pide al usuario (PermisoRedLocal.kt). -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- usesCleartextTraffic="true": permite HTTP sin cifrar hacia http://10.0.2.2:8080.
         SOLO PARA DESARROLLO: en producción el backend debe usar HTTPS y esto se quita. -->
    <application
        android:name=".JuntaZarorApp"
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppJuntaVecinos">

        <!-- Proveedor para compartir la URI de la fotografía -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name"
            android:theme="@style/Theme.AppJuntaVecinos"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Vuelta desde Webpay: el backend redirige a zaror://pago?estado=ok|error.
                 Normalmente lo intercepta el WebView de PagoWebpayScreen; este filtro queda
                 de respaldo por si el enlace se abre fuera de la app (singleTask = reutiliza
                 esta misma pantalla). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="zaror" android:host="pago" />
            </intent-filter>
        </activity>
    </application>

</manifest>